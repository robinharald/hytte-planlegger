rules_version = '2';

// Hytteplanlegger – familiens delte plass.
// Alle forslag ligger under /families/{familyId}/... der familyId er en lang, tilfeldig id som bare finnes i lenken
// familien deler. Enhver (anonymt innlogget) enhet som kjenner id-en kan lese og skrive der. Alt annet er stengt.
// (Firestore begrenser selv hvert dokument til 1 MiB; forslagene er rundt 20–100 kB.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null
                         && familyId.size() >= 24
                         && familyId.size() <= 64;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
